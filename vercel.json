{
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/quietude/dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://YOUR_RENDER_URL.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
